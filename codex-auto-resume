    lines = LOG_PATH.read_text(errors="replace").splitlines()[-args.n:]
    print("\n".join(lines))


def cmd_reset(cfg, args):
    with mutate_state() as st:
        st.clear()
        st.update(default_state())
        st["generation"] = int(now() * 1000)
        add_event(st, "reset", "state cleared by user")
    signal_daemon()
    print("State reset (disarmed, history cleared).")


def cmd_config(cfg, args):
    if not args.key:
        print(json.dumps(cfg, indent=2))
        return
    if args.value is None:
        print(json.dumps(cfg.get(args.key)))
        return
    if args.key not in DEFAULT_CONFIG:
        raise SystemExit("Unknown key %r" % args.key)
    try:
        val = json.loads(args.value)
    except ValueError:
        val = args.value
    user = json.loads(CONFIG_PATH.read_text()) if CONFIG_PATH.exists() else {}
    user[args.key] = val
    APP_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_PATH.write_text(json.dumps(user, indent=2))
    signal_daemon()
    print("%s = %s" % (args.key, json.dumps(val)))


def cmd_doctor(cfg, args):
    ok = True
    def line(good, text):
        nonlocal ok
        ok = ok and good
        print("%s %s" % ("✓" if good else "✗", text))
    line(os.path.exists(cfg["codex_cli"]), "Codex CLI: %s" % cfg["codex_cli"])
    line(daemon_pid() is not None, "daemon running (launchd label %s)" % LABEL)
    line(codex_app_running(cfg), "Codex Desktop running (not required; it is launched when needed)")
    try:
        with AppServer(cfg["codex_cli"]) as srv:
            rl = analyze_rate_limits(srv.call("account/rateLimits/read"))
        line(True, "app-server reachable; usage allowed=%s" % rl["allowed"])
    except Exception as e:
        line(False, "app-server: %s" % e)
    line(pending_queue_items("00000000-0000-0000-0000-000000000000") is not None, "Codex queue database readable")
    return 0 if ok else 1


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="codex-auto-resume", description="Auto-resume Codex Desktop tasks after usage limits reset.")
    sub = ap.add_subparsers(dest="cmd")
    p = sub.add_parser("status", help="show state"); p.add_argument("--json", action="store_true"); p.add_argument("-n", type=int, default=8)
    p = sub.add_parser("arm", help="arm auto-resume for a Codex thread (default: most recent)")
    p.add_argument("thread", nargs="?", help="thread id, id prefix, or exact thread name")
    p.add_argument("--max-resumes", type=int); p.add_argument("--checkpoint", action="store_true",
                   help="ask Codex to keep .codex/resume.md and use it as a completion signal")
    p.add_argument("--yes", "-y", action="store_true"); p.add_argument("--force", action="store_true")
    sub.add_parser("disarm", help="stop watching immediately")
    sub.add_parser("cancel", help="cancel the scheduled resume (stay armed)")
    p = sub.add_parser("resume-now", help="send the continuation now")
    p.add_argument("--force", action="store_true", help="send even if Codex reports usage is unavailable")
    p.add_argument("--yes", "-y", action="store_true", help="don't ask when Codex isn't stopped at a usage limit")
    p = sub.add_parser("logs", help="show the log"); p.add_argument("-f", "--follow", action="store_true"); p.add_argument("-n", type=int, default=40)
    sub.add_parser("reset", help="clear all stored state")
    p = sub.add_parser("check", help="dry-run: show what the helper would decide (sends nothing)"); p.add_argument("thread", nargs="?")
    p = sub.add_parser("threads", help="list recent Codex threads"); p.add_argument("-n", type=int, default=8)
    p = sub.add_parser("config", help="show/set config"); p.add_argument("key", nargs="?"); p.add_argument("value", nargs="?")
    sub.add_parser("doctor", help="check installation")
    p = sub.add_parser("notify-test", help="send a test notification")
    sub.add_parser("daemon", help="run the background loop (used by launchd)")
    args = ap.parse_args(argv)
    if args.cmd == "daemon":
        return run_daemon()
    setup_logging(daemon=False)
    cfg = load_config()
    fn = {"status": cmd_status, "arm": cmd_arm, "disarm": cmd_disarm, "cancel": cmd_cancel,
          "resume-now": cmd_resume_now, "logs": cmd_logs, "reset": cmd_reset, "check": cmd_check,
          "threads": cmd_threads, "config": cmd_config, "doctor": cmd_doctor,
          "notify-test": lambda c, a: notify(c, "Test notification", "Notifications are working.")}.get(args.cmd)
    if fn is None:
        ap.print_help()
        return 0
    try:
        return fn(cfg, args) or 0
    except AppServerError as e:
        print("Could not talk to Codex: %s" % e, file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
